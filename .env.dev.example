# Development and trying it out:   cp .env.dev.example .env
#
# This runs the project against its own mock Reolink NVR, which serves test patterns, and
# bind-mounts the web pages so editing them only needs a browser reload. Four containers.
# For a real installation use .env.example instead (two containers, no mock).

# --- Compose -------------------------------------------------------------------------------
# The mock NVR, and the development conveniences (live-edited web pages). Neither is in
# .env.example, so a real installation runs neither.
COMPOSE_PROFILES=mock
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# This stack's name, and the name of the volume its settings live in. Change it in a SECOND
# copy of the project on the same machine (say one you use to try an upgrade): otherwise
# `docker compose up` there takes over the first one's containers, settings and secrets.
COMPOSE_PROJECT_NAME=viewport

# --- Security -------------------------------------------------------------------------------
# Where the wall is published. 127.0.0.1 is this machine only (a kiosk browser on the same
# device). For a TV or another screen on the network use 0.0.0.0, and then also set the token
# and an admin password below: otherwise anyone on the network can watch and change it.
VIEWPORT_BIND=127.0.0.1
VIEWPORT_PORT=8080
# Lets a screen WATCH the wall: it opens http://<device>:8080/?token=<this>. Blank = anyone who
# can reach the port can watch. Generate one with:
#   docker compose run --rm --no-deps agent python -c "import secrets; print(secrets.token_urlsafe(32))"
VIEWPORT_API_TOKEN=
# Lets someone CHANGE the settings. Blank = choose one in the admin page (Security), which keeps
# only a hash. Setting it here wins over that, and is how a forgotten password is reset.
# To keep it out of this file entirely, use a hash instead:
#   docker compose run --rm --no-deps agent python -m viewport.auth
VIEWPORT_ADMIN_USERNAME=admin
VIEWPORT_ADMIN_PASSWORD=
VIEWPORT_ADMIN_PASSWORD_HASH=
# Names the wall is reached by beyond IP addresses, localhost, single-label names and
# .local/.lan/.home.arpa/.internal: e.g. a reverse proxy's. Comma-separated; *.example.com allowed.
VIEWPORT_ALLOWED_HOSTS=

# --- The NVR or cameras ------------------------------------------------------------------------
# reolink | onvif | rtsp
NVR_TYPE=reolink
# The mock NVR by default. For a real one, its IP address, and a view-only account on it.
NVR_HOST=mock-nvr
NVR_USERNAME=admin
NVR_PASSWORD=mockpass
# HTTP API port (blank = 80, or 443 with NVR_HTTPS=true)
NVR_HTTP_PORT=
NVR_HTTPS=false
NVR_RTSP_PORT=554
# auto = HTTP-FLV for H.264 up to 5 MP, RTSP otherwise. Or force rtsp / flv.
NVR_PROTOCOL=auto
# Retry a stream over the other transport after it keeps failing (true/false)
NVR_PROTOCOL_FALLBACK=true

# --- The mock NVR (COMPOSE_PROFILES=mock) ---------------------------------------------------------
# Its own login. Keep NVR_USERNAME/NVR_PASSWORD above equal to these while NVR_HOST=mock-nvr;
# they are separate so that a real NVR's credentials never reach the mock's container.
MOCK_USERNAME=admin
MOCK_PASSWORD=mockpass
MOCK_CHANNELS=4
# h264 or h265 for the main stream
MOCK_MAIN_CODEC=h264
# Comma-separated 0-based channels to report as offline, e.g. 3
MOCK_OFFLINE_CHANNELS=
# Comma-separated 0-based unused slots (empty name, offline), as a real NVR reports them
MOCK_EMPTY_CHANNELS=
# What GetNetPort says about HTTP. false mimics an HTTPS-only NVR (no HTTP-FLV)
MOCK_HTTP_ENABLED=true

# --- The wall -----------------------------------------------------------------------------------
VIEWPORT_NAME=Viewport
VIEWPORT_MAX_MAIN_STREAMS=1
# Hold an HD stream this long after leaving full screen (0 = release immediately)
VIEWPORT_MAIN_HOLD_SECONDS=30
# proxy (video through the agent, the default and the safe choice) or direct (a kiosk on the
# same device talking to go2rtc itself; see docs/configuration.md first)
PLAYER_TRANSPORT=proxy
# mse (normal) or mjpeg (only for browsers without H.264; also set MJPEG_FALLBACK=true)
PLAYER_MODE=mse
MJPEG_FALLBACK=false
# Pretend this machine is the appliance: the General tab's network and power controls work
# against a device that exists only in memory, and say plainly that they are simulated.
VIEWPORT_HOST_FAKE=1
LOG_LEVEL=INFO
